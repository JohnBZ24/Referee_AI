# Exclude non-production files from `git archive` exports.
# This keeps repo history intact while producing a lean deploy artifact.

/tests export-ignore
/stubs export-ignore
/storage/logs export-ignore
/storage/framework/cache export-ignore
/storage/framework/sessions export-ignore
/storage/framework/testing export-ignore
/storage/framework/views export-ignore
/.env.example export-ignore
/README.md export-ignore
/CLAUDE.md export-ignore
/AGENTS.md export-ignore
